<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BLACK MARKET TERMINAL</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: #050505;
      color: #fff;
      font-family: Arial, Helvetica, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
    }

    .terminal {
      width: min(900px, 90vw);
      text-align: center;
    }

    h1 {
      margin-bottom: 55px;
      font-size: clamp(20px, 3vw, 34px);
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #ff3030;
      text-shadow: 0 0 15px #ff0000;
    }

    /* ЗАГРУЗКА */

    #loader {
      display: block;
    }

    .loading-area {
      width: 100%;
      position: relative;
    }

    .track {
      height: 8px;
      width: 100%;
      background: #222;
      border: 1px solid #444;
      position: relative;
      box-shadow: 0 0 10px #111;
    }

    .progress {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #8b0000, #ff2222);
      animation: loading 10s linear forwards;
      box-shadow: 0 0 15px #ff0000;
    }

    .rolling-clown {
      position: absolute;
      bottom: 8px;
      left: 0;
      width: 58px;
      height: 58px;
      transform: translateX(-50%);
      animation: roll 10s linear forwards;
    }

    .clown-head {
      width: 58px;
      height: 58px;
      border-radius: 50%;
      background: #eee;
      border: 3px solid #222;
      position: relative;
      box-shadow: 0 0 12px #fff;
    }

    .clown-head::before,
    .clown-head::after {
      content: "";
      position: absolute;
      top: 17px;
      width: 10px;
      height: 13px;
      background: #111;
      border-radius: 50%;
    }

    .clown-head::before {
      left: 13px;
    }

    .clown-head::after {
      right: 13px;
    }

    .hair {
      position: absolute;
      top: -10px;
      left: 4px;
      width: 50px;
      height: 20px;
      background: #d40000;
      border-radius: 50%;
    }

    .nose {
      position: absolute;
      z-index: 5;
      width: 17px;
      height: 17px;
      background: #ff1717;
      border-radius: 50%;
      top: 26px;
      left: 18px;
      box-shadow: 0 0 12px #ff0000;
    }

    .mouth {
      position: absolute;
      width: 27px;
      height: 11px;
      border-bottom: 3px solid #111;
      border-radius: 50%;
      bottom: 8px;
      left: 13px;
    }

    @keyframes loading {
      from { width: 0%; }
      to { width: 100%; }
    }

    @keyframes roll {
      from {
        left: 0%;
        transform: translateX(-50%) rotate(0deg);
      }
      to {
        left: 100%;
        transform: translateX(-50%) rotate(1080deg);
      }
    }

    /* КЛОУН ПОСЛЕ ЗАГРУЗКИ */

    #clown-screen {
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .big-clown {
      position: relative;
      width: 230px;
      height: 230px;
      border-radius: 50%;
      background: #eee;
      border: 8px solid #222;
      box-shadow:
        0 0 25px #ff0000,
        inset 0 0 30px #aaa;
      cursor: pointer;
      transition: transform .2s, filter .2s;
    }

    .big-clown:hover {
      transform: scale(1.04);
      filter: brightness(1.15);
    }

    .big-clown .eye {
      position: absolute;
      top: 67px;
      width: 27px;
      height: 38px;
      background: #111;
      border-radius: 50%;
    }

    .big-clown .eye.left {
      left: 48px;
    }

    .big-clown .eye.right {
      right: 48px;
    }

    .big-nose {
      position: absolute;
      z-index: 3;
      top: 100px;
      left: 50%;
      transform: translateX(-50%);
      width: 58px;
      height: 58px;
      background: #e60000;
      border-radius: 50%;
      box-shadow:
        0 0 20px #ff0000,
        inset -8px -8px 10px #a00000;
    }

    .big-mouth {
      position: absolute;
      bottom: 40px;
      left: 50%;
      transform: translateX(-50%);
      width: 105px;
      height: 48px;
      border-bottom: 7px solid #111;
      border-radius: 50%;
    }

    .hair-big {
      position: absolute;
      top: -40px;
      left: 20px;
      width: 190px;
      height: 70px;
      background: #d00000;
      border-radius: 50%;
      z-index: -1;
      box-shadow: 0 0 20px #ff0000;
    }

    #success {
      display: none;
      margin-top: 35px;
      font-size: 28px;
      color: #ff2222;
      text-shadow: 0 0 15px red;
      animation: appear .4s ease-out;
    }

    @keyframes appear {
      from {
        opacity: 0;
        transform: scale(.7);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    .hint {
      margin-top: 20px;
      color: #777;
      font-size: 13px;
      letter-spacing: 2px;
    }
  </style>
</head>

<body>

  <main class="terminal">

    <h1>Добро пожаловать к BLACK MARKET TERMINAL</h1>

    <!-- Загрузка -->
    <section id="loader">
      <div class="loading-area">

        <div class="rolling-clown">
          <div class="clown-head">
            <div class="hair"></div>
            <div class="nose"></div>
            <div class="mouth"></div>
          </div>
        </div>

        <div class="track">
          <div class="progress"></div>
        </div>

      </div>
    </section>

    <!-- Экран после загрузки -->
    <section id="clown-screen">

      <div class="big-clown" id="clown">

        <div class="hair-big"></div>

        <div class="eye left"></div>
        <div class="eye right"></div>

        <div class="big-nose"></div>

        <div class="big-mouth"></div>

      </div>

      <div class="hint">НАЖМИ НА КРАСНЫЙ НОС</div>

      <div id="success">Заказ принят</div>

    </section>

  </main>

  <script>
    // Через 10 секунд показываем главного клоуна
    setTimeout(() => {
      document.getElementById("loader").style.display = "none";
      document.getElementById("clown-screen").style.display = "flex";
    }, 10000);

    // Клик по клоуну / красному носу
    document.getElementById("clown").addEventListener("click", () => {
      document.getElementById("success").style.display = "block";
    });
  </script>

</body>
</html>
